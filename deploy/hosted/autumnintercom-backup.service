[Unit]
Description=Encrypted Autumn Intercom database and file backup
After=network-online.target autumnintercom-hosted.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/autumnintercom/backup.env
Environment=AUTUMNINTERCOM_ATTACHMENTS_DIR=/var/lib/autumnintercom-hosted/attachments
Environment=AUTUMNINTERCOM_SERVICE_ENV=/etc/autumnintercom/hosted.env
Environment=AUTUMNINTERCOM_BINARY=/opt/autumnintercom-hosted/current/autumnintercom
Environment=AUTUMNINTERCOM_BACKUP_CACHE=/var/cache/autumnintercom-backup
Environment=AUTUMNINTERCOM_BACKUP_STATE=/var/lib/autumnintercom-backup
Environment=RESTIC_CACHE_DIR=/var/cache/autumnintercom-backup/restic
Environment=GOMAXPROCS=2
CacheDirectory=autumnintercom-backup
CacheDirectoryMode=0700
StateDirectory=autumnintercom-backup
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/autumnintercom-hosted/current/backup.py
TimeoutStartSec=30min
UMask=0077
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autumnintercom-hosted/attachments

