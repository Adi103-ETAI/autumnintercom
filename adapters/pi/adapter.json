{
  "schemaVersion": 1,
  "id": "pi-native",
  "adapterVersion": "0.2.1",
  "harnessFamily": "Pi",
  "status": "experimental",
  "protocolVersions": [
    "0.1"
  ],
  "transport": "native",
  "delivery": "pull",
  "lifecycleEvidence": "process",
  "capabilities": [
    "discovery",
    "messaging",
    "requests",
    "tasks",
    "escalation",
    "bounded-context"
  ],
  "testedVersions": [],
  "platforms": [],
  "maintainer": "Autumn",
  "repository": "https://github.com/Adi103-ETAI/autumnintercom",
  "limitations": [
    "Experimental native extension; released-host execution and reload behavior are not certified.",
    "Host session hooks open and close the shared Go bridge; no idle/wake claims."
  ],
  "conformanceCommand": "autumnintercom-conformance --profile mcp-adapter --start-runtime --adapter-command autumnintercom --adapter-arg mcp --adapter-arg stdio --check-self-registration",
  "configuration": {
    "file": "bridge.json.example",
    "format": "json",
    "location": "AUTUMNINTERCOM_PI_CONFIG (reviewed local bridge JSON)",
    "executable": "pi",
    "docs": "https://github.com/earendil-works/pi/blob/main/packages/coding-agent/docs/extensions.md",
    "recommendedWaitMs": 10000
  }
}
